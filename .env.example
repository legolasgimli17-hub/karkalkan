# KârKalkan server-side configuration template
# Never commit real passwords, database URLs, marketplace credentials or service-role keys.

# Supabase Edge runtime usually provides SUPABASE_URL automatically.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Secret: direct Postgres connection used by Edge Functions that access Vault/SQL directly.
SUPABASE_DB_URL=postgresql://REPLACE_WITH_BUYER_SECRET

# Publishable key map expected by the current Edge Function sources.
# This is not a service-role key.
SUPABASE_PUBLISHABLE_KEYS={"default":"sb_publishable_REPLACE_ME"}
