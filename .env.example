# KârKalkan server-side configuration template
# Never commit real passwords, database URLs, marketplace credentials or service-role keys.

# Supabase Edge runtime usually provides SUPABASE_URL automatically.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Canonical application origin. Optional preview access must be buyer-controlled;
# do not hard-code a personal Vercel team/project hostname in source.
KARKALKAN_APP_ORIGIN=https://karkalkan.vercel.app
# Example only: -your-project-your-team.vercel.app
# Leave unset in production unless buyer-owned previews must call production Edge Functions.
KARKALKAN_VERCEL_PREVIEW_HOST_SUFFIX=

# Secret: Supabase transaction pooler URL. Edge Functions reject direct :5432 URLs.
# Copy Dashboard -> Connect -> Transaction pooler; port must be 6543.
KARKALKAN_DB_POOLER_URL=postgres://postgres.YOUR_PROJECT_REF:REPLACE_WITH_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# Publishable key map expected by the current Edge Function sources.
# This is not a service-role key.
SUPABASE_PUBLISHABLE_KEYS={"default":"sb_publishable_REPLACE_ME"}

# Optional until a Sentry project is created. When set, safe sync failures and
# unhandled critical-function exceptions are sent without request bodies or PII.
SENTRY_DSN=https://PUBLIC_KEY@YOUR_SENTRY_HOST/PROJECT_ID
SENTRY_ENVIRONMENT=production

# Evidence-bound finance AI. The key is server-side only. The finance-ai Edge
# Function sends aggregate KârKalkan evidence, never marketplace credentials,
# raw orders, customer records or bank descriptions. With no key configured,
# the workspace remains usable in deterministic evidence-only mode.
OPENAI_API_KEY=REPLACE_ME
KARKALKAN_AI_MODEL=gpt-5.6-luna

# Paddle Billing. Keep sandbox and live values separate. Checkout remains
# disabled unless the API key, webhook secret, HTTPS checkout URL and all three
# recurring price IDs are present and structurally valid.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=REPLACE_ME
PADDLE_WEBHOOK_SECRET=pdl_ntfset_REPLACE_ME
PADDLE_CHECKOUT_URL=https://karkalkan.vercel.app/uygulama#billing
PADDLE_PRICE_STARTER_MONTHLY=pri_REPLACE_ME
PADDLE_PRICE_GROWTH_MONTHLY=pri_REPLACE_ME
PADDLE_PRICE_SCALE_MONTHLY=pri_REPLACE_ME
# Paddle's SDKs use a short replay window by default. KârKalkan defaults to 5
# seconds and accepts an explicit value only in the 5-120 second range.
PADDLE_WEBHOOK_TOLERANCE_SECONDS=5

# Commercial/legal launch evidence. These values are not secrets, but the
# launch-readiness endpoint intentionally keeps them server-side and exposes
# booleans only. Public legal pages must still be updated with the same real
# operator/contact details before their noindex/draft status is removed.
KARKALKAN_LEGAL_OPERATOR_NAME=REPLACE_WITH_REAL_PERSON_OR_ENTITY
KARKALKAN_LEGAL_CONTACT_EMAIL=REPLACE_WITH_SERVICEABLE_EMAIL
KARKALKAN_LEGAL_APPROVED_AT=YYYY-MM-DD
KARKALKAN_LEGAL_PAGES_FINAL=false

# Amazon SP-API public application configuration. These values belong only in
# Supabase Edge Function secrets and must be supplied by the authorized
# business account owner after Amazon application registration.
AMAZON_SPAPI_APPLICATION_ID=amzn1.sellerapps.app.REPLACE_ME
AMAZON_LWA_CLIENT_ID=amzn1.application-oa2-client.REPLACE_ME
AMAZON_LWA_CLIENT_SECRET=REPLACE_ME
AMAZON_SPAPI_REDIRECT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/amazon-auth-callback
# Keep draft during beta authorization; change to published only after approval.
AMAZON_SPAPI_APP_STAGE=draft
